# Copy to `.env` (gitignored) and fill in real values. Never commit secrets.
ORCHESTRATOR_MODEL_PROVIDER=openai
ORCHESTRATOR_MODEL_NAME=gpt-4.1
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_API_BASE=
ORCHESTRATOR_TEMPERATURE=0
ORCHESTRATOR_MAX_OUTPUT_TOKENS=4096
ORCHESTRATOR_TIMEOUT_S=60
ORCHESTRATOR_MAX_REQUESTS_PER_MINUTE=12
ORCHESTRATOR_MAX_CONCURRENT_WORKERS=10
ORCHESTRATOR_RETRY_MAX_ATTEMPTS=5
ORCHESTRATOR_RETRY_BASE_DELAY_S=1.0
ORCHESTRATOR_RETRY_MAX_DELAY_S=30.0
ORCHESTRATOR_RETRY_JITTER_S=0.5
ORCHESTRATOR_PRICE_PER_1M_INPUT=2.00
ORCHESTRATOR_PRICE_PER_1M_OUTPUT=8.00
